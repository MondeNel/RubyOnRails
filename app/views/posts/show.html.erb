<div class="max-w-md mx-auto mt-10 px-4">
  <% if notice.present? %>
    <p class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-md px-4 py-2 mb-4">
      <%= notice %>
    </p>
  <% end %>

  <%= render @post %>

  <div class="flex items-center justify-between mt-6 text-sm">
    <div class="space-x-3">
      <%= link_to "Edit this post", edit_post_path(@post), class: "text-blue-600 hover:text-blue-800 hover:underline" %>
      <span class="text-gray-300">|</span>
      <%= link_to "Back to posts", posts_path, class: "text-blue-600 hover:text-blue-800 hover:underline" %>
    </div>

    <%= button_to "Destroy this post", @post, method: :delete,
          class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-3 py-1.5 rounded-md transition-colors",
          form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>