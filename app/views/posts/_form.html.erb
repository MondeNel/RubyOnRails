<%= form_with(model: post, class: "max-w-md mx-auto space-y-5 bg-white p-6 rounded-lg shadow-md") do |form| %>
  <% if post.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md p-4">
      <h2 class="font-semibold mb-2">
        <%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:
      </h2>

      <ul class="list-disc list-inside text-sm space-y-1">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.textarea :title, rows: 4, class: "w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :user_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :user_id, class: "w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= form.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-md transition-colors cursor-pointer" %>
  </div>
<% end %>