<% content_for :title, "New post" %>

<div class="max-w-md mx-auto mt-10 px-4">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">New Post</h1>

  <%= render "form", post: @post %>

  <div class="mt-6 text-center">
    <%= link_to "← Back to posts", posts_path, class: "text-sm text-blue-600 hover:text-blue-800 hover:underline" %>
  </div>
</div>