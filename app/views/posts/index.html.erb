<% content_for :title, "Posts" %>

<div class="max-w-2xl mx-auto mt-10 px-4">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Posts</h1>

  <div id="posts">
    <%= render @posts %>
  </div>

  <div class="mt-6">
    <%= link_to "New post", new_post_path, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-md transition-colors" %>
  </div>
</div>